;; The IBEC source catalog, as Kotoba.
;;
;; GENERATED by tools/gen_kotoba.cljs from data/datascript-tx.edn, which
;; src/association/facts.cljc holds as a hand-authored literal. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs, which
;; the .cljc cannot. Do not edit by hand -- regenerate.
;;
;; `:topic` is a SET in the .cljc. A set has no order and `topic` is indexed by
;; position, so this file uses the order the data file writes. `by-topic-id`
;; answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every field of
;; every entry against the .cljc, so this file cannot drift from the data without
;; the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "ibec"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 8 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 8)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.founding-1993-fie-cii-merger")
          (string=? f "title") (option-some-of [:option :string] "Ibec founded by merger of FIE and CII (Wikipedia)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "governance-program")
          (string=? f "url") (option-some-of [:option :string] "https://en.wikipedia.org/wiki/Ibec")
          (string=? f "url-provenance") (option-some-of [:option :string] "wikipedia-corroborated")
          (string=? f "established-date") (option-some-of [:option :string] "1993")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-17")
          :else (option-none-of [:option :string]))
      (= i 1) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.predecessor-dublin-employers-federation-1911")
          (string=? f "title") (option-some-of [:option :string] "Dublin Employers' Federation, Ibec's earliest predecessor body (Wikipedia)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "governance-program")
          (string=? f "url") (option-some-of [:option :string] "https://en.wikipedia.org/wiki/Ibec")
          (string=? f "url-provenance") (option-some-of [:option :string] "wikipedia-corroborated")
          (string=? f "established-date") (option-some-of [:option :string] "1911")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-17")
          :else (option-none-of [:option :string]))
      (= i 2) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.rules-govern-confederation")
          (string=? f "title") (option-some-of [:option :string] "The Ibec Rules govern the confederation, setting its structures and the procedures for appointment to the National Council and the Ibec Board (ibec.ie)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "governance-program")
          (string=? f "url") (option-some-of [:option :string] "https://www.ibec.ie/about-us/our-governance/ibec-structures")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-ibec-ie")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 3) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.rules-document-registered-2022-08-22")
          (string=? f "title") (option-some-of [:option :string] "Ibec Rules, published by Ibec as a 36-page document labelled registered 22 08 2022 (ibec.ie)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "governance-program")
          (string=? f "url") (option-some-of [:option :string] "https://cdn.ibec.ie/-/media/documents/about-us/ibec-rules-registered-22-08-2022.pdf?rev=e350c0a7c6dd49e3b979730f42b90543")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-ibec-ie")
          (string=? f "last-revised-date") (option-some-of [:option :string] "2022-08-22")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 4) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.clg-company-under-companies-act-2014")
          (string=? f "title") (option-some-of [:option :string] "Ibec CLG is a company under the Companies Act 2014, established by the Irish Business and Employers Confederation (ibec.ie)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "governance-program")
          (string=? f "url") (option-some-of [:option :string] "https://www.ibec.ie/about-us/our-governance/ibec-structures")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-ibec-ie")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 5) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.companies-act-2014-number-38")
          (string=? f "title") (option-some-of [:option :string] "Companies Act 2014 (Number 38 of 2014), the statute Ibec CLG is constituted under (Irish Statute Book)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "statute")
          (string=? f "url") (option-some-of [:option :string] "https://www.irishstatutebook.ie/eli/2014/act/38/enacted/en/html")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-irishstatutebook-ie")
          (string=? f "established-date") (option-some-of [:option :string] "2014")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 6) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.trade-associations-under-rules-and-byelaws")
          (string=? f "title") (option-some-of [:option :string] "Over 39 trade associations, established under the Ibec Rules and Byelaws for consultation, representation and the provision of Ibec services (ibec.ie)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "membership-rule")
          (string=? f "url") (option-some-of [:option :string] "https://www.ibec.ie/about-us/trade-associations")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-ibec-ie")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      (= i 7) (cond
          (string=? f "id") (option-some-of [:option :string] "ibec.eu-transparency-register-self-declared")
          (string=? f "title") (option-some-of [:option :string] "Ibec states it maintains a presence on the EU Transparency Register under identification number 479468313744-50 (ibec.ie, self-declared; not verified against the register)")
          (string=? f "association") (option-some-of [:option :string] "ibec")
          (string=? f "isic") (option-some-of [:option :string] "9411")
          (string=? f "country") (option-some-of [:option :string] "IRL")
          (string=? f "kind") (option-some-of [:option :string] "governance-program")
          (string=? f "url") (option-some-of [:option :string] "https://www.ibec.ie/about-us/our-regions-and-brussels-office/our-brussels-office")
          (string=? f "url-provenance") (option-some-of [:option :string] "official-ibec-ie-self-declared")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
    (= i 0) 1
    (= i 1) 1
    (= i 2) 1
    (= i 3) 1
    (= i 4) 2
    (= i 5) 2
    (= i 6) 2
    (= i 7) 1
    :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 1) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 2) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 3) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 4) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "corporate-form")
          :else (option-none-of [:option :string]))
      (= i 5) (cond
          (= t 0) (option-some-of [:option :string] "corporate-form")
          (= t 1) (option-some-of [:option :string] "statute")
          :else (option-none-of [:option :string]))
      (= i 6) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "membership")
          :else (option-none-of [:option :string]))
      (= i 7) (cond
          (= t 0) (option-some-of [:option :string] "eu-representation")
          :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") 6
    (string=? candidate "corporate-form") 2
    (string=? candidate "statute") 1
    (string=? candidate "membership") 1
    (string=? candidate "eu-representation") 1
    :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 3 "id")
        (= i 4) (entry-field a 4 "id")
        (= i 5) (entry-field a 6 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "corporate-form") (cond
        (= i 0) (entry-field a 4 "id")
        (= i 1) (entry-field a 5 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "statute") (cond
        (= i 0) (entry-field a 5 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "membership") (cond
        (= i 0) (entry-field a 6 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "eu-representation") (cond
        (= i 0) (entry-field a 7 "id")
        :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-9411-irl-ibec Wave 0 (ADR-2607141700): 8 Ibec entries -- 5 from Ibec's or the Irish State's own publication, 2 Wikipedia-corroborated, 1 self-declared by Ibec and not confirmed against the issuing register. Extend `association.facts/catalog`, never fabricate an id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
