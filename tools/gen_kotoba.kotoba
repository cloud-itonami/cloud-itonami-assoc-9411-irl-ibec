;; tools/gen_kotoba.cljs -- emit src/association_facts.kotoba from data/datascript-tx.edn.
;;
;; The .kotoba header has always said "GENERATED from data/datascript-tx.edn".
;; Until this script existed that was an aspiration: the port was written by hand,
;; so the header named a generator that did not exist and a transcription error was
;; only ever caught downstream, by the parity test.
;;
;; Run:  kbb --backend sci tools/gen_kotoba.cljk
;;
;; This does NOT make the parity test redundant. The .cljc catalog is authored by
;; hand and this file is generated from the .edn, so the two faces the parity test
;; compares are still produced independently -- which is the only reason comparing
;; them means anything.
(ns gen-kotoba
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            ["fs" :as fs]))

(def entries (edn/read-string (fs/readFileSync "data/datascript-tx.edn" "utf8")))
(def slug "ibec")

(def fields ["id" "title" "association" "isic" "country" "kind" "url"
             "url-provenance" "established-date" "last-revised-date" "retrieved-at"])

(defn field-val [e f]
  (let [v (get e (keyword "association-rule" f))]
    (cond (nil? v) nil (keyword? v) (name v) :else v)))

(def OPT "[:option :string]")
(defn some-of [s] (str "(option-some-of " OPT " " (pr-str s) ")"))
(def none-of (str "(option-none-of " OPT ")"))

(defn indent [n s] (str (apply str (repeat n " ")) s))

;; --- topics, in the order the data file writes them (a set has no order) -------
(def topic-names (mapv (fn [e] (mapv name (:association-rule/topic e))) entries))
(def all-topics (vec (distinct (mapcat identity topic-names))))
(defn entries-with-topic [t]
  (vec (keep-indexed (fn [i ts] (when (some #{t} ts) i)) topic-names)))

;; --- coverage note: must equal association.facts/note-for, which is computed ---
(defn provenance-tier [e]
  (let [p (name (:association-rule/url-provenance e))]
    (cond (= p "wikipedia-corroborated") :corroborated
          (re-find #"self-declared$" p) :self-declared
          (re-find #"^official-" p) :official
          :else :unknown)))
(def tally (frequencies (map provenance-tier entries)))
(defn cnt [k] (get tally k 0))
(def coverage-note
  (str "cloud-itonami-assoc-9411-irl-ibec Wave 0 (ADR-2607141700): "
       (count entries) " Ibec entries -- "
       (cnt :official) " from Ibec's or the Irish State's own publication, "
       (cnt :corroborated) " Wikipedia-corroborated, "
       (cnt :self-declared) " self-declared by Ibec and not confirmed against the issuing register. "
       "Extend `association.facts/catalog`, never fabricate an id/url."))

(defn cond-block
  "(cond t1 v1 t2 v2 ... :else fallback), one clause per line at `col`."
  [col clauses fallback]
  (str "(cond\n"
       (str/join "\n" (map (fn [[t v]] (indent col (str t " " v))) clauses))
       "\n" (indent col (str ":else " fallback)) ")"))

(def entry-field-body
  (cond-block 6
    (map-indexed
      (fn [i e]
        [(str "(= i " i ")")
         (cond-block 10
           (keep (fn [f] (when-let [v (field-val e f)]
                           [(str "(string=? f " (pr-str f) ")") (some-of v)]))
                 fields)
           none-of)])
      entries)
    none-of))

(def topic-body
  (cond-block 6
    (map-indexed
      (fn [i ts]
        [(str "(= i " i ")")
         (cond-block 10
           (map-indexed (fn [t nm] [(str "(= t " t ")") (some-of nm)]) ts)
           none-of)])
      topic-names)
    none-of))

(def topic-count-body
  (cond-block 4
    (map-indexed (fn [i ts] [(str "(= i " i ")") (str (count ts))]) topic-names)
    "0"))

(def by-topic-count-body
  (cond-block 4
    (map (fn [t] [(str "(string=? candidate " (pr-str t) ")")
                  (str (count (entries-with-topic t)))]) all-topics)
    "0"))

(def by-topic-id-body
  (cond-block 4
    (map (fn [t]
           [(str "(string=? candidate " (pr-str t) ")")
            (cond-block 8
              (map-indexed (fn [n idx] [(str "(= i " n ")") (str "(entry-field a " idx " \"id\")")])
                           (entries-with-topic t))
              none-of)])
         all-topics)
    none-of))

(def out
  (str ";; The IBEC source catalog, as Kotoba.
;;
;; GENERATED by tools/gen_kotoba.cljs from data/datascript-tx.edn, which
;; src/association/facts.cljc holds as a hand-authored literal. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs, which
;; the .cljc cannot. Do not edit by hand -- regenerate.
;;
;; `:topic` is a SET in the .cljc. A set has no order and `topic` is indexed by
;; position, so this file uses the order the data file writes. `by-topic-id`
;; answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every field of
;; every entry against the .cljc, so this file cannot drift from the data without
;; the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a " (pr-str slug) "))

(defn entry-count [a :string] :i64 (if (association-covered? a) " (count entries) " 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i " (count entries) ")) false))

(defn entry-field [a :string i :i64 f :string] " OPT "
  (if (valid-entry? a i)
    " entry-field-body "
    " none-of "))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    " topic-count-body "
    0))

(defn topic [a :string i :i64 t :i64] " OPT "
  (if (valid-entry? a i)
    " topic-body "
    " none-of "))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    " by-topic-count-body "
    0))

(defn by-topic-id [a :string candidate :string i :i64] " OPT "
  (if (association-covered? a)
    " by-topic-id-body "
    " none-of "))

(defn coverage-note [a :string] " OPT "
  (if (association-covered? a)
    " (some-of coverage-note) "
    " none-of "))

(defn main [] :i64 0)
"))

(fs/writeFileSync "src/association_facts.kotoba" out)
(println "wrote src/association_facts.kotoba"
         (count entries) "entries," (count all-topics) "topics:" (str/join ", " all-topics))
